--- a/frontend/src/ingress.js
+++ b/frontend/src/ingress.js
@@ -0,0 +1,104 @@
+// Home Assistant Ingress serves Dispatcharr from a path it only settles on at
+// request time, and NGINX writes that path into window.SUB_PATH on the way
+// past. Dispatcharr addresses everything from the site root, which under
+// Ingress belongs to Home Assistant rather than to this app, so left alone
+// those requests would never arrive.
+//
+// Correcting them in one place is what keeps this to a single file rather than
+// a patch against every call site, and means a call site added upstream later
+// is carried along instead of quietly breaking.
+//
+// One thing this cannot reach: mpegts.js runs its loader inside a Web Worker,
+// which has its own globals. The player call sites put the sub path on
+// themselves for that reason.
+
+export const subPath = () =>
+  (typeof window !== 'undefined' && window.SUB_PATH) || '';
+
+// The address players, Plex, Emby, Jellyfin and anything else outside Home
+// Assistant reach this app at. Falls back to wherever the browser already is,
+// which is the right answer whenever this app is not behind Ingress.
+export const publicBase = () => {
+  if (typeof window === 'undefined') return '';
+  return (
+    window.PUBLIC_URL ||
+    `${window.location.protocol}//${window.location.host}`
+  );
+};
+
+export const prefixed = (url) => {
+  const base = subPath();
+  if (!base || typeof url !== 'string') return url;
+
+  // Same origin, but spelled out in full. Several call sites build their URLs
+  // that way, and a plain "starts with a slash" test would miss all of them.
+  const { origin } = window.location;
+  if (url.startsWith(origin)) {
+    const rest = url.slice(origin.length);
+    return rest.startsWith(`${base}/`) ? url : `${origin}${base}${rest}`;
+  }
+
+  // Root relative. A protocol relative URL is somebody else's host and is left
+  // alone, as is anything already carrying the prefix.
+  if (
+    url.startsWith('/') &&
+    !url.startsWith('//') &&
+    !url.startsWith(`${base}/`)
+  ) {
+    return `${base}${url}`;
+  }
+
+  return url;
+};
+
+if (subPath()) {
+  const originalFetch = globalThis.fetch;
+  globalThis.fetch = function (input, init) {
+    if (typeof input === 'string') {
+      return originalFetch(prefixed(input), init);
+    }
+    if (typeof Request !== 'undefined' && input instanceof Request) {
+      return originalFetch(new Request(prefixed(input.url), input), init);
+    }
+    return originalFetch(input, init);
+  };
+
+  const originalOpen = XMLHttpRequest.prototype.open;
+  XMLHttpRequest.prototype.open = function (method, url, ...rest) {
+    return originalOpen.call(
+      this,
+      method,
+      typeof url === 'string' ? prefixed(url) : url,
+      ...rest
+    );
+  };
+
+  // Artwork is the case no request interceptor can reach: the browser starts
+  // fetching the instant the address is assigned, so by the time anything
+  // watching the document could correct it the 404 has already happened.
+  const descriptor = Object.getOwnPropertyDescriptor(
+    HTMLImageElement.prototype,
+    'src'
+  );
+  if (descriptor && descriptor.set) {
+    const originalSet = descriptor.set;
+    Object.defineProperty(HTMLImageElement.prototype, 'src', {
+      ...descriptor,
+      set(value) {
+        originalSet.call(
+          this,
+          typeof value === 'string' ? prefixed(value) : value
+        );
+      },
+    });
+  }
+
+  const originalSetAttribute = HTMLImageElement.prototype.setAttribute;
+  HTMLImageElement.prototype.setAttribute = function (name, value) {
+    return originalSetAttribute.call(
+      this,
+      name,
+      name === 'src' && typeof value === 'string' ? prefixed(value) : value
+    );
+  };
+}
