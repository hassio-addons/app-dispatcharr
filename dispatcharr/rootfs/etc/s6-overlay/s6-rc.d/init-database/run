#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Home Assistant Community App: Dispatcharr
# Creates the database and brings it up to date
# ==============================================================================
declare -i attempt

readonly PGBIN="/usr/lib/postgresql/${PG_MAJOR}/bin"

# PostgreSQL has only just been asked to start, and it replays its write ahead
# log before it accepts anything.
attempt=0
until s6-setuidgid postgres "${PGBIN}/pg_isready" -q -h /run/postgresql; do
    attempt=$((attempt + 1))
    if [[ ${attempt} -gt 60 ]]; then
        bashio::exit.nok "PostgreSQL did not become ready in time"
    fi
    sleep 1
done

# The role and the database this app owns. Both are made once and then found
# on every start after that.
if ! s6-setuidgid postgres "${PGBIN}/psql" -h /run/postgresql -d postgres -tAc \
        "SELECT 1 FROM pg_roles WHERE rolname='dispatcharr'" | grep -q 1; then
    bashio::log.info "Creating the database role..."
    s6-setuidgid postgres "${PGBIN}/createuser" -h /run/postgresql dispatcharr \
        || bashio::exit.nok "Failed creating the database role"
fi

if ! s6-setuidgid postgres "${PGBIN}/psql" -h /run/postgresql -d postgres -tAc \
        "SELECT 1 FROM pg_database WHERE datname='dispatcharr'" | grep -q 1; then
    bashio::log.info "Creating the database..."
    s6-setuidgid postgres "${PGBIN}/createdb" -h /run/postgresql \
        --owner=dispatcharr --encoding=UTF8 dispatcharr \
        || bashio::exit.nok "Failed creating the database"
fi

bashio::log.info "Bringing the database up to date..."
cd /app \
    || bashio::exit.nok "Could not change to the application directory"

python manage.py migrate --noinput \
    || bashio::exit.nok "Failed bringing the database up to date"
